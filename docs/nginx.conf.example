# Example nginx server block for TNT Store.
# Adjust server_name, root and your TLS setup (HTTPS is REQUIRED for PWA install).

server {
    listen 443 ssl http2;
    server_name store.example.com;

    # Must match the DEPLOY_PATH GitHub Actions variable
    root /var/www/tnt-store;
    index index.html;

    # SPA fallback: deep links like /app/owner/repo resolve to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed build assets are immutable — cache aggressively
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # The service worker and manifest must always be revalidated,
    # otherwise updates to the app can take days to reach clients.
    location = /sw.js {
        add_header Cache-Control "no-cache";
    }
    location = /manifest.webmanifest {
        add_header Cache-Control "no-cache";
        types { } default_type application/manifest+json;
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;
}
