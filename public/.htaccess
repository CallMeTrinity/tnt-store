# TNT Store — Apache config (Infomaniak). Ships with the build via public/.

Options -MultiViews
AddType application/manifest+json .webmanifest

# SPA fallback: deep links like /app/owner/repo resolve to index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Hashed build assets are immutable — cache aggressively
  <FilesMatch "\.(js|css|png|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The service worker, manifest and entry point must always revalidate,
  # otherwise app updates can take days to reach clients
  <FilesMatch "^(sw\.js|registerSW\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
